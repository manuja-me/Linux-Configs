#!/usr/bin/env python3
import sys
import json
import subprocess
import os

LUA_FILE = os.path.expanduser("~/.config/hypr/hyprland.lua")

def toggle_overlay():
    try:
        with open(LUA_FILE, "r") as f:
            content = f.read()
        if "overlay = true" in content:
            new_content = content.replace("overlay = true", "overlay = false")
            state_text = "Hidden"
        elif "overlay = false" in content:
            new_content = content.replace("overlay = false", "overlay = true")
            state_text = "Active"
        else:
            new_content = content.replace("debug = {", "debug = {\n        overlay = true,")
            state_text = "Active"
        with open(LUA_FILE, "w") as f:
            f.write(new_content)
        subprocess.run(["hyprctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["notify-send", "-u", "low", "-i", "preferences-desktop-display", "FPS Overlay", state_text], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["killall", "-SIGUSR2", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def set_hz(target_hz):
    try:
        cmd = f'hl.monitor({{ output = "eDP-1", mode = "1920x1080@{target_hz}.00Hz", position = "0x0", scale = 1.0 }})'
        subprocess.run(["hyprctl", "eval", cmd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["notify-send", "-u", "low", "-i", "video-display", "Display Refresh Rate", f"Switched to {target_hz}Hz"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        subprocess.run(["killall", "-SIGUSR2", "waybar"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass

def toggle_hz():
    try:
        raw = subprocess.check_output(["hyprctl", "monitors", "-j"], stderr=subprocess.DEVNULL).decode()
        monitors = json.loads(raw)
        edp = next((m for m in monitors if m.get("name") == "eDP-1"), monitors[0])
        current_hz = round(edp.get("refreshRate", 0))
    except Exception:
        current_hz = 144

    target = 60 if current_hz > 100 else 144
    set_hz(target)

def get_status():
    try:
        raw = subprocess.check_output(["hyprctl", "monitors", "-j"], stderr=subprocess.DEVNULL).decode()
        monitors = json.loads(raw)
        edp = next((m for m in monitors if m.get("name") == "eDP-1"), monitors[0])
        hz = round(edp.get("refreshRate", 0))
        vrr = edp.get("vrr", False)
    except Exception:
        hz = 144
        vrr = True

    try:
        opt = subprocess.check_output(["hyprctl", "getoption", "debug:overlay", "-j"], stderr=subprocess.DEVNULL).decode()
        data = json.loads(opt)
        overlay = (data.get("int") == 1 or data.get("bool") is True)
    except Exception:
        overlay = False

    icon = "󰓅"
    text = f"{icon} {hz}Hz"
    if vrr:
        text += " VRR"
    if overlay:
        text += " [FPS]"

    tooltip = (
        f"Monitor: eDP-1\n"
        f"Mode: 1920x1080@{hz}Hz\n"
        f"Adaptive-Sync (VRR): {'Enabled' if vrr else 'Disabled'}\n"
        f"Live On-screen FPS Overlay: {'Active' if overlay else 'Hidden'}\n\n"
        f"• Left-Click: Toggle 60Hz ⟷ 144Hz\n"
        f"• Right-Click: Toggle FPS Overlay\n"
        f"• Scroll: 144Hz (Up) / 60Hz (Down)"
    )

    cls = "vrr"
    if overlay:
        cls += " active"

    print(json.dumps({
        "text": text,
        "tooltip": tooltip,
        "class": cls
    }))

if __name__ == "__main__":
    if len(sys.argv) > 1:
        arg = sys.argv[1]
        if arg in ("--toggle-hz", "--toggle"):
            toggle_hz()
        elif arg in ("--toggle-overlay", "--toggle-fps"):
            toggle_overlay()
        elif arg == "--set-144":
            set_hz(144)
        elif arg == "--set-60":
            set_hz(60)
        else:
            toggle_hz()
    else:
        get_status()
