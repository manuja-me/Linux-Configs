#!/usr/bin/env bash

# Toggle rofi if already open
if pgrep -x "rofi" >/dev/null; then
	pkill -x "rofi"
	exit 0
fi


## Copyright (C) 2020-2026 Aditya Shakya <adi1090x@gmail.com>

# Import Current Theme
DIR="$HOME/.config/hypr"
RASI="$DIR/rofi/runner.rasi"

# Run
rofi \
    -show run \
	-theme ${RASI}
